# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=trader
DB_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── StockTwits ────────────────────────────────────────────────────────────────
# No token required — public unauthenticated endpoints are used automatically.
# STOCKTWITS_TOKEN is no longer used; remove it if present in your .env.

# ── Bluesky (AT Protocol) ─────────────────────────────────────────────────────
# Free account at bsky.app. App password: Settings → App Passwords.
# Leave both empty to disable the Bluesky source.
BLUESKY_HANDLE=                    # e.g. yourhandle.bsky.social
BLUESKY_APP_PASSWORD=              # e.g. xxxx-xxxx-xxxx-xxxx

# ── Reddit API (optional) ─────────────────────────────────────────────────────
# Free OAuth. Register at reddit.com/prefs/apps (type: script).
# Leave empty to disable the Reddit source.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-trading-bot/0.1

# ── X / Twitter API ───────────────────────────────────────────────────────────
# DISABLED BY DEFAULT — X is now pay-per-use ($0.005/request, no free tier).
# Cost estimate: 50 tickers × 288 polls/day ≈ $72/day ($2,160/month).
# To enable: set X_BEARER_TOKEN below AND toggle "Enable X API" in Config UI.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Alpha Vantage (optional discovery source) ─────────────────────────────────
# Free key at alphavantage.co/support/#api-key (25 req/day, Redis-cached).
# Leave empty to disable (Yahoo Finance screener still runs without a key).
ALPHA_VANTAGE_API_KEY=

# ── LunarCrush (optional) ─────────────────────────────────────────────────────
LUNARCRUSH_API_KEY=

# ── Interactive Brokers ───────────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497=TWS paper, 4002=Gateway paper, 4001=Gateway live
IBKR_CLIENT_ID=10
IBKR_SCANNER_PORT=7497  # port for market scanner (can match IBKR_PORT)
IBKR_SCANNER_CLIENT_ID=99  # must differ from IBKR_CLIENT_ID to avoid conflicts
IBKR_PAPER=true

# ── System ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TRADING_MODE=paper       # paper | live
PAPER_INITIAL_CASH=100000
