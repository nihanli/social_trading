# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USER=trader
DB_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Twitter / X API ───────────────────────────────────────────────────────────
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Reddit API ────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-trading-bot/0.1

# ── StockTwits ────────────────────────────────────────────────────────────────
STOCKTWITS_TOKEN=

# ── Alpha Vantage ─────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=

# ── LunarCrush (optional) ─────────────────────────────────────────────────────
LUNARCRUSH_API_KEY=

# ── Interactive Brokers ───────────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497=TWS paper, 4002=Gateway paper, 4001=Gateway live
IBKR_CLIENT_ID=10
IBKR_SCANNER_CLIENT_ID=99
IBKR_PAPER=true

# ── System ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TRADING_MODE=paper       # paper | live
