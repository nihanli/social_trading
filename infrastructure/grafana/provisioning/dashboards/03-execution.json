{
  "uid": "social-trading-execution",
  "title": "Execution",
  "tags": ["social-trading", "execution"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Orders Filled (1h)",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {}},
      "targets": [{"expr": "increase(orders_total{status=\"filled\"}[1h])", "legendFormat": "Filled", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 2, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Orders Rejected (1h)",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 3}]}}},
      "targets": [{"expr": "increase(orders_total{status=\"rejected\"}[1h])", "legendFormat": "Rejected", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 3, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Positions Closed (1h)",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {}},
      "targets": [{"expr": "increase(positions_closed_total[1h])", "legendFormat": "Closed", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 4, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Circuit Breaker State",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "text": {}},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "NORMAL"}, "1": {"text": "REDUCED 50%"}, "2": {"text": "DAILY HALT"}, "3": {"text": "FULL HALT"}}}, ], "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "orange", "value": 2}, {"color": "red", "value": 3}]}}},
      "targets": [{"expr": "circuit_breaker_state", "legendFormat": "State", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 5, "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "type": "timeseries", "title": "Order Flow (fills / rejections per 5m)",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [
        {"expr": "rate(orders_total{status=\"filled\"}[5m])", "legendFormat": "Filled {{ticker}}", "refId": "A"},
        {"expr": "rate(orders_total{status=\"rejected\"}[5m])", "legendFormat": "Rejected {{ticker}}", "refId": "B"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 6, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "type": "timeseries", "title": "Unrealized P&L by Position",
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{"expr": "position_unrealized_pnl", "legendFormat": "{{ticker}} {{direction}}", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 7, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "type": "timeseries", "title": "Position Exits by Reason",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [{"expr": "rate(positions_closed_total[5m])", "legendFormat": "{{reason}}", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    }
  ]
}
