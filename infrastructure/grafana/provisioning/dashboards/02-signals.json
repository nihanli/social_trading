{
  "uid": "social-trading-signals",
  "title": "Signal Feed",
  "tags": ["social-trading", "signals"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Signals Generated (1h)",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {}},
      "targets": [{"expr": "increase(signals_generated_total[1h])", "legendFormat": "Signals/h", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 2, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Signals Approved (1h)",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {}},
      "targets": [{"expr": "increase(signals_approved_total[1h])", "legendFormat": "Approved/h", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 3, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Signals Rejected (1h)",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}]}}},
      "targets": [{"expr": "increase(signals_rejected_total[1h])", "legendFormat": "Rejected/h", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 4, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Active Tickers",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {}},
      "targets": [{"expr": "active_tickers_total", "legendFormat": "Tickers", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 5, "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "type": "timeseries", "title": "Signal Generation Rate",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [
        {"expr": "rate(signals_generated_total[5m])", "legendFormat": "generated {{ticker}} {{direction}}", "refId": "A"},
        {"expr": "rate(signals_approved_total[5m])", "legendFormat": "approved {{ticker}}", "refId": "B"},
        {"expr": "rate(signals_rejected_total[5m])", "legendFormat": "rejected ({{reason}})", "refId": "C"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 6, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "type": "timeseries", "title": "Signal Quality Score Distribution (p50/p90/p99)",
      "fieldConfig": {"defaults": {}},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(signal_quality_score_bucket[5m]))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.90, rate(signal_quality_score_bucket[5m]))", "legendFormat": "p90", "refId": "B"},
        {"expr": "histogram_quantile(0.99, rate(signal_quality_score_bucket[5m]))", "legendFormat": "p99", "refId": "C"}
      ],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 7, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "type": "timeseries", "title": "Sentiment Score by Ticker",
      "fieldConfig": {"defaults": {}},
      "targets": [{"expr": "ticker_sentiment_score", "legendFormat": "{{ticker}}", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 8, "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "type": "timeseries", "title": "Rejection Reason Breakdown",
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [{"expr": "rate(signals_rejected_total[5m])", "legendFormat": "{{reason}}", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    }
  ]
}
