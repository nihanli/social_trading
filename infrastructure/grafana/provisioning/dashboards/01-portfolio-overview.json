{
  "uid": "social-trading-portfolio",
  "title": "Portfolio Overview",
  "tags": ["social-trading", "portfolio"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Net Liquidation (USD)",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 90000}]}}},
      "targets": [{"expr": "paper_equity_usd", "legendFormat": "NLV", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 2, "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Daily P&L %",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": -0.02}, {"color": "yellow", "value": 0}, {"color": "green", "value": 0.005}]}}},
      "targets": [{"expr": "daily_pnl_pct", "legendFormat": "Daily P&L", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 3, "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Drawdown from HWM",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.10}]}}},
      "targets": [{"expr": "drawdown_from_hwm", "legendFormat": "Drawdown", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 4, "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "type": "stat", "title": "Open Positions",
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "blue", "value": 0}]}}},
      "targets": [{"expr": "open_positions_count", "legendFormat": "Positions", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 5, "gridPos": {"x": 0, "y": 4, "w": 24, "h": 8},
      "type": "timeseries", "title": "Portfolio Equity (USD)",
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{"expr": "paper_equity_usd", "legendFormat": "Equity", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 6, "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "type": "timeseries", "title": "Unrealized P&L by Ticker",
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "targets": [{"expr": "position_unrealized_pnl", "legendFormat": "{{ticker}} {{direction}}", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    },
    {
      "id": 7, "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "type": "timeseries", "title": "Drawdown History",
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"fillOpacity": 20}}},
      "targets": [{"expr": "drawdown_from_hwm", "legendFormat": "Drawdown", "refId": "A"}],
      "datasource": {"type": "prometheus", "uid": "Prometheus"}
    }
  ]
}
